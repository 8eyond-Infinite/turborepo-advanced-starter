NODE_ENV=development
PORT=3001

# JWT signing keys — sinh bang: openssl rand -hex 32
# Startup validation yeu cau >= 32 ky tu khi NODE_ENV=production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Origin cua cac frontend (admin 5173, client 3005)
CORS_ORIGINS=http://localhost:5173,http://localhost:3005
CLIENT_URL=http://localhost:3005
# When true, newly registered accounts must verify email before login.
EMAIL_VERIFICATION_REQUIRED=false
# lax khi frontend/API cùng site; none chỉ cho HTTPS cross-site staging.
REFRESH_COOKIE_SAME_SITE=lax

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=
# Managed environments should provide one connection string instead of the
# host fields above. Supports redis:// and rediss://; when set, it wins.
REDIS_URL=

OUTBOX_POLL_INTERVAL_MS=100
# Số ngày giữ lại row outbox đã PUBLISHED trước khi dọn (0 = không dọn)
OUTBOX_RETENTION_DAYS=30
# Disabled until the real project's audit/archive/legal-hold policy is approved.
AUDIT_RETENTION_DAYS=0

# Pino log level (mặc định: info ở production, debug ở môi trường khác)
LOG_LEVEL=
# Bearer token for GET /metrics. Optional locally, >= 32 characters in production.
METRICS_TOKEN=

DATABASE_URL=postgresql://postgres:<db-password>@localhost:5433/starter_db?schema=public

# Mail (Maildev local)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@turbostarter.dev
