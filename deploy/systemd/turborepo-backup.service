[Unit]
Description=Turborepo starter PostgreSQL backup and restore verification
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=turborepo
Group=turborepo
WorkingDirectory=/opt/turborepo-starter
ExecStart=/opt/turborepo-starter/deploy/compose/scripts/backup-and-verify.sh

# The job needs Docker access, its repository backup directory and outbound
# network access when encrypted off-host backup is enabled.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/turborepo-starter/deploy/compose/backups /opt/turborepo-starter/deploy/compose/backup-status
