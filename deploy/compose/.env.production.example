# Compose identity and immutable application artifact.
COMPOSE_PROJECT_NAME=turborepo-starter
SERVER_IMAGE=ghcr.io/your-organization/your-repository/server
# Production must use a commit SHA or release version, never latest.
SERVER_IMAGE_TAG=replace-with-commit-sha

# Public API address. Use http://localhost for the local production-like drill.
# On a public server use a real DNS name such as api.example.com.
API_ADDRESS=http://localhost
ACME_EMAIL=ops@example.com

# Datastore credentials. Use URL-safe random values because they are embedded
# in connection URLs. Do not commit the real .env.production file.
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=replace-with-url-safe-random-password
DATABASE_URL=postgresql://starter:replace-with-url-safe-random-password@postgres:5432/starter?schema=public
REDIS_PASSWORD=replace-with-url-safe-random-password

# Application secrets: generate independently with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret

# Exact frontend origins, comma separated, without trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://localhost:3005
# Use lax when frontend and API are same-site; none requires HTTPS.
REFRESH_COOKIE_SAME_SITE=lax

LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=100
OUTBOX_RETENTION_DAYS=30

# Configure a real SMTP provider before enabling the worker in production.
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=

# Local is acceptable only for a single-node drill; real production should use
# an S3-compatible object store so uploads survive replacement and scaling.
STORAGE_PROVIDER=local
S3_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bootstrap is explicit and disabled by default. Enable only for the first
# controlled seed invocation, then return it to false.
ALLOW_PRODUCTION_SEED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
