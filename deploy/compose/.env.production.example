# Compose identity and immutable application artifact.
COMPOSE_PROJECT_NAME=turborepo-starter
SERVER_IMAGE=ghcr.io/your-organization/your-repository/server
# Production must use a commit SHA or release version, never latest.
SERVER_IMAGE_TAG=replace-with-commit-sha

# Public API address. Use http://localhost for the local production-like drill.
# On a public server use a real DNS name such as api.example.com.
API_ADDRESS=http://localhost
ACME_EMAIL=ops@example.com

# Datastore credentials. Use URL-safe random values because they are embedded
# in connection URLs. Do not commit the real .env.production file.
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=replace-with-url-safe-random-password
DATABASE_URL=postgresql://starter:replace-with-url-safe-random-password@postgres:5432/starter?schema=public
REDIS_PASSWORD=replace-with-url-safe-random-password

# Application secrets: generate independently with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret

# Exact frontend origins, comma separated, without trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://localhost:3005
# Public Client origin used to create password-reset links.
CLIENT_URL=http://localhost:3005
EMAIL_VERIFICATION_REQUIRED=false
# Use lax when frontend and API are same-site; none requires HTTPS.
REFRESH_COOKIE_SAME_SITE=lax

LOG_LEVEL=info
# Prometheus sends this as Authorization: Bearer <token> when scraping /metrics.
METRICS_TOKEN=replace-with-a-different-32-character-secret
OUTBOX_POLL_INTERVAL_MS=100
OUTBOX_RETENTION_DAYS=30
# Disabled by default. Set only after legal/compliance and archive requirements
# for the real project define how long audit evidence may be retained.
AUDIT_RETENTION_DAYS=0
# Local verified backups older than this are pruned by backup-and-verify.sh.
# Keep empty until encrypted off-host copy/upload is configured and tested.
BACKUP_RETENTION_DAYS=
# Optional encrypted off-host backup. The password file must live outside the
# repository and be readable only by the backup service account.
OFFSITE_BACKUP_ENABLED=false
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/turborepo-starter/restic-password
RESTIC_HOST=turborepo-starter
# The hourly health check fails when the last fully successful cycle is older.
BACKUP_MAX_AGE_HOURS=26
BACKUP_STATUS_FILE=

# Disabled means email jobs complete as explicitly skipped instead of retrying
# against an empty SMTP host. Enable only with a real SMTP provider.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=

# Local is acceptable only for a single-node drill; real production should use
# an S3-compatible object store so uploads survive replacement and scaling.
STORAGE_PROVIDER=local
S3_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bootstrap is explicit and disabled by default. Enable only for the first
# controlled seed invocation, then return it to false.
ALLOW_PRODUCTION_SEED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
