# File nay chi phuc vu cac script Prisma chay tu root (pnpm db:generate/migrate/seed).
# Runtime cua API doc apps/server/.env — xem apps/server/.env.example.
# KHONG commit gia tri that; copy sang .env va dien gia tri cua ban.

DATABASE_URL=postgresql://postgres:<db-password>@localhost:5433/starter_db?schema=public

# Bat buoc khi chay `pnpm db:seed` lan dau (tao tai khoan admin).
# Chon mat khau manh; seed se tu hash bang bcrypt.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
