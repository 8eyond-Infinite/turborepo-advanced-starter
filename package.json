{
  "name": "turborepo-advanced-starter",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "prebuild": "pnpm db:generate",
    "predev": "pnpm db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=client",
    "dev:server": "turbo run dev --filter=server",
    "dev:admin": "turbo run dev --filter=admin",
    "db:generate": "dotenv -e .env -- pnpm --filter=@repo/database db:generate",
    "db:push": "dotenv -e .env -- pnpm --filter=@repo/database db:push",
    "db:migrate": "dotenv -e .env -- pnpm --filter=@repo/database db:migrate",
    "db:deploy": "dotenv -e .env -- pnpm --filter=@repo/database db:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter=@repo/database db:seed",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "e2e:frontend:prepare": "node scripts/prepare-frontend-e2e.mjs",
    "e2e:admin": "pnpm e2e:frontend:prepare && pnpm --filter=admin e2e",
    "e2e:client": "pnpm e2e:frontend:prepare && pnpm --filter=client e2e",
    "verify:compose": "docker compose --env-file deploy/compose/.env.production.example -f deploy/compose/compose.production.yaml config --quiet",
    "verify:env": "node scripts/verify-environment-contract.mjs",
    "verify:migrations": "pnpm --filter=@repo/database db:verify-migrations",
    "verify:backup": "sh deploy/compose/scripts/backup-offsite.test.sh && sh deploy/compose/scripts/verify-backup-freshness.test.sh",
    "verify:alerts": "node scripts/verify-prometheus-rules.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3",
      "@hono/node-server": ">=2.0.5",
      "ajv@<7": "6.14.0",
      "brace-expansion@<2": "1.1.17",
      "brace-expansion@>=2 <3": "2.1.3",
      "brace-expansion@>=4 <5.0.8": "5.0.8",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-uri": ">=3.1.4",
      "find-my-way": ">=9.7.0",
      "flatted": ">=3.4.2",
      "js-yaml": ">=5.2.2",
      "minimatch@<4": "3.1.4",
      "minimatch@>=9 <10": "9.0.7",
      "picomatch@<3": "2.3.2",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "valibot": ">=1.4.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2"
      ]
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
