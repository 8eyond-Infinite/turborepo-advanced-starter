{
  "name": "turborepo-advanced-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "prebuild": "pnpm db:generate",
    "predev": "pnpm db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=client",
    "dev:server": "turbo run dev --filter=server",
    "dev:admin": "turbo run dev --filter=admin",
    "db:generate": "dotenv -e .env -- pnpm --filter=@repo/database db:generate",
    "db:push": "dotenv -e .env -- pnpm --filter=@repo/database db:push",
    "db:migrate": "dotenv -e .env -- pnpm --filter=@repo/database db:migrate",
    "db:deploy": "dotenv -e .env -- pnpm --filter=@repo/database db:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter=@repo/database db:seed",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "e2e:admin:prepare": "node scripts/prepare-admin-e2e.mjs",
    "e2e:admin": "pnpm e2e:admin:prepare && pnpm --filter=admin e2e",
    "verify:compose": "docker compose --env-file deploy/compose/.env.production.example -f deploy/compose/compose.production.yaml config --quiet",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:render": "node scripts/verify-render-deployment.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.7.4",
    "turbo": "^2.10.4",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3",
      "fast-uri": ">=3.1.4",
      "find-my-way": ">=9.7.0",
      "js-yaml": ">=5.2.2",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2"
      ]
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
